    <!-- ==================== 无障碍 / 设备管理员 描述 ==================== -->
    <string name="accessibility_label">FocusLock · App watcher</string>
    <string name="accessibility_summary">Blocks non-whitelisted apps during a lock</string>
    <string name="accessibility_desc">Used to identify which app is currently in the foreground during a lock session. If that app is not on the whitelist, the lock screen is brought straight back to the front. The service does not read or upload any screen content; all decisions are made on-device.</string>
    <string name="device_admin_desc">Prevents FocusLock from being uninstalled or force-stopped during a lock session.</string>
    <string name="device_admin_explain">Prevents "FocusLock" from being uninstalled or force-stopped during a lock session</string>
    <string name="lock_channel_name">Lock status</string>
    <string name="lock_channel_desc">Shows remaining time while a lock is running</string>

