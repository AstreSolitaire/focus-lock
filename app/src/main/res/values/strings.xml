    <!-- ==================== 权限中心 ==================== -->
    <string name="perm_title">Permission centre</string>
    <string name="perm_subtitle">%1$d/%2$d required permissions ready</string>
    <string name="perm_all_ok">All required permissions are ready</string>
    <string name="perm_all_ok_desc">Locks will start on schedule and non-whitelisted apps will be blocked</string>
    <string name="perm_missing_desc">With permissions missing, a lock may not pop up or take effect</string>
    <string name="perm_go">Enable</string>
    <string name="perm_footer">Tip: phones from Xiaomi / Huawei / OPPO / vivo and others have their own autostart and background-run switches. Allow those too, otherwise the lock will be unstable.</string>

    <string name="perm_accessibility_title">Accessibility service (app watcher)</string>
    <string name="perm_accessibility_desc">Identifies which app is in the foreground during a lock and bounces anything outside the whitelist back to the lock screen. This is the core of enforcement — without it a lock only works on the honour system.</string>
    <string name="perm_overlay_title">Display over other apps</string>
    <string name="perm_overlay_desc">Android 10 and later forbids apps from showing UI from the background. With this permission granted, the lock screen pops up full-screen on time. Without it you only get a notification and have to tap it yourself.</string>
    <string name="perm_notification_title">Notifications</string>
    <string name="perm_notification_desc">Used for the persistent notification showing remaining time, and for end-of-session alerts.</string>
    <string name="perm_alarm_title">Exact alarms</string>
    <string name="perm_alarm_desc">Makes locks start and end on the minute. Without it the system delays alarms by a few minutes.</string>
    <string name="perm_battery_title">Ignore battery optimisation</string>
    <string name="perm_battery_desc">Adds the app to the battery-optimisation allowlist so the lock service isn\'t frozen or killed in the background.</string>
    <string name="perm_usage_title">Usage access (optional)</string>
    <string name="perm_usage_desc">A fallback signal alongside accessibility. In the vast majority of cases everything works without it.</string>
    <string name="perm_admin_title">Device admin (optional)</string>
    <string name="perm_admin_desc">Prevents uninstalling or force-stopping the app during a lock, making it harder to break out of.</string>

