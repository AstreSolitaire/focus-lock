    <string name="set_strict_settings">Block System Settings</string>
    <string name="set_strict_settings_desc">Stops accessibility being turned off, the clock being changed, or the app being force-stopped mid-session</string>
    <string name="set_strict_shade">Block the notification shade (may break shutdown)</string>
    <string name="set_strict_shade_desc">The system power menu is drawn by SystemUI, so blocking the shade blocks it too — you may be unable to power off or reboot. Leave this off.</string>
    <string name="set_strict_assistant">Block the built-in AI assistant</string>
    <string name="set_strict_assistant_desc">Off by default. Many phones map a long-press of the power button to the assistant, so blocking it makes the power button appear dead. The assistant cannot bypass the lock anyway \u2014 anything it opens gets bounced back.</string>
    <string name="set_block_uninstall">Prevent uninstall during a lock</string>
    <string name="set_block_uninstall_on">Active (requires device admin)</string>
    <string name="set_block_uninstall_off">Needs device-admin permission first</string>
    <string name="set_lock_screen_on_start">Turn the screen off when a lock starts</string>
    <string name="set_lock_screen_on_start_desc">Straight to black, removing one second of hesitation</string>
    <string name="set_reminders">Reminders</string>
    <string name="set_vibrate">Vibration</string>
    <string name="set_vibrate_desc">A short buzz when a session starts and ends</string>
    <string name="set_emergency">Emergency unlock</string>
    <string name="set_emergency_desc">With a password set, long-pressing the progress ring during a lock lets you enter it to end the session early. Leave it blank for no way out at all — just wait it out. A forgotten password cannot be recovered.</string>
