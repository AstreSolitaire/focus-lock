    <!-- ==================== 权限中心 ==================== -->
    <string name="perm_title">权限中心</string>
    <string name="perm_subtitle">必需项 %1$d/%2$d 已完成</string>
    <string name="perm_all_ok">全部必需权限已就绪</string>
    <string name="perm_all_ok_desc">到点会自动锁机，白名单之外的应用会被拦下</string>
    <string name="perm_missing_desc">权限不全时，锁机可能不会自动弹出或不生效</string>
    <string name="perm_go">去开启</string>
    <string name="perm_footer">提示：不同品牌的手机（小米 / 华为 / OPPO / vivo 等）在「无障碍」和「后台运行」上还有各自的自启动开关，建议一并允许，锁机才会稳定。</string>

    <string name="perm_accessibility_title">无障碍服务（应用监视）</string>
    <string name="perm_accessibility_desc">锁机期间识别当前打开的应用，白名单之外的一律弹回锁机界面。这是拦截功能的核心，不开启则锁机只能靠自觉。</string>
    <string name="perm_overlay_title">悬浮窗权限</string>
    <string name="perm_overlay_desc">Android 10 起禁止应用在后台直接弹出界面。授予悬浮窗权限后，锁机到点才能自动全屏弹出。不开的话到点只会有通知，需要手动点开。</string>
    <string name="perm_notification_title">通知权限</string>
    <string name="perm_notification_desc">用于显示锁机剩余时间的常驻通知，以及到点提醒。</string>
    <string name="perm_alarm_title">精确闹钟</string>
    <string name="perm_alarm_desc">保证锁机在整点准时开始、准时结束。未授权时系统会延迟几分钟，锁机会晚一点生效。</string>
    <string name="perm_battery_title">忽略电池优化</string>
    <string name="perm_battery_desc">把本应用加入电池优化白名单，避免锁机服务在后台被系统冻结或杀掉。</string>
    <string name="perm_usage_title">使用情况访问（可选）</string>
    <string name="perm_usage_desc">在无障碍之外提供一层兜底判定。绝大多数情况下不开启也能正常工作。</string>
    <string name="perm_admin_title">设备管理员（可选）</string>
    <string name="perm_admin_desc">锁机期间阻止卸载或强行停止本应用，让锁机更难被中途破坏。</string>

